<!DOCTYPE html>
<html lang="en">
<head>
    <title>404 - Not Found</title>
    <%- include('partials/header') %>
</head>
<body class="error-page">
    <%- include('partials/navbar') %>

    <div class="error-container" style="text-align: center; padding: 100px 20px;">
        <h1 style="font-size: 5rem; margin-bottom: 20px;">404</h1>
        <h2><%= typeof message !== 'undefined' ? message : 'Page not found' %></h2>
        <p style="margin: 20px 0;">The page you're looking for doesn't exist or has been moved.</p>
        <a href="/" class="btn" style="display:inline-block; margin-top:20px;">Return Home</a>
    </div>

    <%- include('partials/footer') %>
</body>
</html>
