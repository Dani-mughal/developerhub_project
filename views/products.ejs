<!DOCTYPE html>
<html lang="en">
<head>
    <title>Our Products | Premium Store</title>
    <%- include('partials/header') %>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="products-container">
        <header class="page-header">
            <h1>Our Collection</h1>
            <% if(typeof searchQuery !== 'undefined' && searchQuery) { %>
                <p>Search results for: "<%= searchQuery %>"</p>
            <% } else { %>
                <p>Quality materials. Timeless designs.</p>
            <% } %>
        </header>

        <div class="products-grid">
            <% if(products && products.length > 0) { %>
                <% products.forEach(product => { %>
                    <div class="product-card">
                        <div class="image-wrapper">
                            <img src="<%= product.image %>" alt="<%= product.name %>" class="card-img">
                        </div>
                        <div class="info">
                            <h3><%= product.name %></h3>
                            <p class="category"><%= product.category %></p>
                            <p class="price">$<%= product.price.toFixed(2) %></p>
                            <p class="stock-status <%= product.stock > 0 ? 'in-stock' : 'out-of-stock' %>">
                                <%= product.stock > 0 ? 'In Stock' : 'Out of Stock' %>
                            </p>
                            <a href="/products/<%= product.id %>" class="btn-sm">View Details</a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="no-products">
                    <h2>No Products Found</h2>
                    <p>Try searching for a different category or name.</p>
                    <a href="/products" class="btn">View All Products</a>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>
